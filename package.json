{
  "name": "notify-slack-action",
  "version": "2.0.0",
  "main": "dist/index.js",
  "repository": "git@github.com:ravsamhq/notify-slack-action.git",
  "author": "RavSam Web Solutions",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts' '__tests__/**/*.ts' '*.ts'",
    "format-check": "prettier --check 'src/**/*.ts' '__tests__/**/*.ts' '*.ts'",
    "lint": "eslint src __tests__ '*.ts' '*.mjs'",
    "package": "ncc build src/main.ts -o dist --license licenses.txt",
    "test": "vitest run",
    "all": "npm run typecheck && npm run format && npm run lint && npm test && npm run package"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^9.39.5",
    "eslint-plugin-github": "^6.1.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
